# Select the Docker Hub image tag, without a leading v (including prereleases).
OSCTRL_VERSION=0.6.2
OSCTRL_IMAGE_NAMESPACE=jmpsec

# Required: generate independent values with openssl rand -hex 32.
JWT_SECRET=
POSTGRES_DB_PASSWORD=
OSCTRL_PASS=
OSCTRL_USER=admin
POSTGRES_DB_NAME=osctrl
POSTGRES_DB_USERNAME=osctrl

NGINX_VERSION=1.31.0-alpine
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7-alpine

# Use a reachable hostname:port for remote agents; keep ports in sync below.
STAGING_TLS_HOST=localhost:9443
STAGING_FRONTEND_HOST=localhost:9444
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_TLS_PORT=9443
STAGING_FRONTEND_PORT=9444
# Database/cache host ports are always bound to localhost.
STAGING_POSTGRES_PORT=15432
STAGING_REDIS_PORT=16379
STAGING_TLS_CERT=./deploy/docker/conf/staging/tls/osctrl.crt
STAGING_TLS_KEY=./deploy/docker/conf/staging/tls/osctrl.key
