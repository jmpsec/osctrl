FROM ubuntu:24.04

ARG COMPONENT=api
# TARGETPLATFORM / TARGETOS / TARGETARCH are supplied by buildx per platform.
# GoReleaser (dockers_v2) stages each platform's binary under
# $TARGETPLATFORM/ in the build context, so a single multi-platform build
# picks up the right architecture without per-arch build args.
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

RUN apt-get update -y -q && \
    apt-get install -y -q --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /usr/sbin/nologin osctrl-${COMPONENT}
RUN mkdir -p /opt/osctrl/bin \
    /opt/osctrl/config && \
    chown -R osctrl-${COMPONENT}:osctrl-${COMPONENT} /opt/osctrl

COPY ${TARGETPLATFORM}/osctrl-${COMPONENT}-${TARGETOS}-${TARGETARCH} /opt/osctrl/bin/osctrl-${COMPONENT}
RUN chmod 0755 /opt/osctrl/bin/osctrl-${COMPONENT}

USER osctrl-${COMPONENT}
WORKDIR /opt/osctrl
EXPOSE 9002/tcp
CMD ["/opt/osctrl/bin/osctrl-api"]
